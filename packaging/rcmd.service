[Unit]
Description=RedCraft Manager Daemon
Documentation=https://github.com/redcraft-org/RedCraftManagerDaemon
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=minecraft
Group=minecraft
ExecStart=/usr/local/bin/rcmd --config /etc/rcmd/config.toml serve
Restart=on-failure
RestartSec=5

# Secrets for the template builds and the config repository go in here.
# Nothing in this file, and nothing in git.
EnvironmentFile=-/etc/rcmd/env

StateDirectory=rcmd
ConfigurationDirectory=rcmd

# Stopping rcmd does not stop a single server: they live in their own
# tmux sessions and rcmd adopts them again when it comes back.
KillMode=process
TimeoutStopSec=30

NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=false

[Install]
WantedBy=multi-user.target
